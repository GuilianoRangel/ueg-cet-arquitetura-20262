# Nome base da aplicação para os containers (<APP_NAME>-backend e <APP_NAME>-frontend)
APP_NAME=ueg-arquitetura

# Porta pública exposta pelo container do frontend (Nginx)
FRONTEND_PORT=80

# Prefixo da API usado no build do frontend (padrão /api com proxy reverso no Nginx)
API_URL=/api

# Segurança JWT (OBRIGATÓRIO alterar em produção)
JWT_SECRET=troque-por-uma-chave-secreta-forte-em-producao
JWT_EXPIRES_IN=1h

# Credenciais do usuário administrador inicial (seed)
ADMIN_EMAIL=admin@ueg.br
ADMIN_PASSWORD=troque-essa-senha-admin

# URL pública da aplicação (usada em links de recuperação de senha e CORS)
FRONTEND_URL=https://seu-dominio.com
CORS_ORIGIN=https://seu-dominio.com

# Configuração de e-mail
EMAIL_DISABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
